# vpn-check - will a VPN work on the wifi I'm on right now?
# Run it on any network. No arguments, nothing to configure.
set -uo pipefail

c(){ printf '\033[%sm%s\033[0m\n' "$1" "$2"; }
ok(){ c '1;32' "  PASS  $1"; }; bad(){ c '1;31' "  FAIL  $1"; }; note(){ c '0;37' "        $1"; }

SSID=$(nmcli -t -f ACTIVE,SSID device wifi 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}')
c '1;36' "Network: ${SSID:-unknown}   $(ip -4 route show default | awk '{print "via "$3" dev "$5; exit}')"
echo

pass=0; fail=0

# 1. Baseline: is the internet up at all?
if curl -s --max-time 8 -o /dev/null https://github.com; then ok "basic internet"; ((pass++))
else bad "no internet at all - nothing else matters"; exit 1; fi

# 2. Proton VPN server IPs on TCP/443. These are real Proton endpoints; if a
#    TLS handshake completes, the provider is not IP-blocked here.
protok=0
for ip in 156.47.78.177 212.104.101.106 89.187.170.159; do
  if timeout 12 openssl s_client -connect "$ip:443" -servername www.google.com </dev/null 2>&1 \
       | grep -q 'BEGIN CERTIFICATE'; then protok=1; break; fi
done
if ((protok)); then ok "Proton VPN servers reachable on TCP/443"; ((pass++))
else bad "Proton VPN server IPs are dropped on TCP/443"; ((fail++))
     note "the network blocks the provider by address - Stealth/OpenVPN-TCP cannot help"; fi

# 3. General UDP egress, using a non-Google STUN server (Google is often
#    allowlisted for Meet, which would give a false pass).
if /usr/bin/python3 - <<'PY' 2>/dev/null
import socket, struct, sys
tid=b'\x21\x12\xa4\x42'+b'\x09'*12
for host in ("stun.cloudflare.com","stun.nextcloud.com"):
    try: ip=socket.gethostbyname(host)
    except Exception: continue
    for port in (3478,443):
        s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM); s.settimeout(4)
        try:
            s.sendto(struct.pack('>HH',1,0)+tid,(ip,port)); s.recvfrom(2048); sys.exit(0)
        except Exception: pass
        finally: s.close()
sys.exit(1)
PY
then ok "general UDP egress works"; ((pass++))
else bad "UDP blocked except to allowlisted hosts"; ((fail++))
     note "kills WireGuard/OpenVPN-UDP and all online gaming"; fi

# 4. Is DNS forced to a local resolver?
DNS=$(resolvectl status 2>/dev/null | awk '/Current DNS Server/{print $NF; exit}')
if [[ $DNS =~ ^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.) ]]; then
  bad "DNS forced to local resolver ($DNS)"; ((fail++))
else ok "DNS not hijacked (${DNS:-unknown})"; ((pass++)); fi

echo
if ((fail==0)); then
  c '1;32' "VERDICT: a VPN should work here. Try:  pvpn up"
elif ((protok)); then
  c '1;33' "VERDICT: partly filtered. Proton is reachable, so try:  pvpn try"
else
  c '1;31' "VERDICT: VPNs are blocked by address on this network."
  note "Not fixable from this machine, on any OS. Try another SSID"
  note "(doe-guest / BYOD) or a phone hotspot, then run vpn-check again."
fi
